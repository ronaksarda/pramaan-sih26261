    },
    "INCREASE_INTAKE": {
      "label": "Increase in Intake (APH cl. 2.6)",
      "required": {
        "affidavit.pdf": "APH Annexure 2 §2.1(i)",
        "fee_receipt.pdf": "APH Annexure 2 §2.1(ii)",
        "occupancy_certificate.pdf": "APH Annexure 2 §2.1(iii)",
        "fire_noc.pdf": "APH Annexure 2 §2.1(v)",
        "satellite_map.pdf": "APH Annexure 2 §2.1(vi)",
