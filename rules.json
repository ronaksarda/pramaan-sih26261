  "required_fields": {
    "affidavit.pdf": [
      "Institution Name",
      "AICTE Permanent ID",
      "Signatory",
      "E-Stamp No",
      "E-Stamp Date",
      "Affidavit Date"
    ],
    "fire_noc.pdf": [
      "NOC No",
      "Institution Name",
      "Valid Upto"
    ],
    "occupancy_certificate.pdf": [
      "Certificate No",
      "Institution Name",
      "Issue Date",
      "DigiLocker URI"
    ],
    "fee_receipt.pdf": [
      "Transaction ID",
      "AICTE Permanent ID"
    ],
    "satellite_map.pdf": [
      "Latitude",
      "Longitude"
    ]
  },
  "expiry_fields": {
    "fire_noc.pdf": "Valid Upto"
  },
  "norms": {
    "expiry_warn_days": 90,
    "programme_years": 4,
    "structural_certificate_after_years": 30,
    "name_match_ok": 90,
    "name_match_review": 75,
    "photo_geofence_m": 200,
    "photo_geofence_high_m": 1000,
    "photo_max_age_days": 180,
    "map_match_m": 100,
    "phash_max_distance": 6,
    "source_retries": 3,
    "scene_min_confidence": 0.6,
    "intake_jump_pct": 50
